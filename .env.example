# ── 資料庫 ───────────────────────────────────────────
# 必須是「非超級使用者」角色，否則 Row-Level Security 不會生效
DATABASE_URL=postgresql://yangbenbu:yangbenbu@localhost:5432/yangbenbu

# ── 欄位加密（身分證字號等）──────────────────────────
# 產生方式：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=
FIELD_HASH_KEY=

# ── API ──────────────────────────────────────────────
API_PORT=4100
# 允許發出寫入請求的前端來源（CSRF 防護）
WEB_ORIGIN=http://localhost:3100
# 正式環境設為 true：員工必須啟用兩步驟驗證才能使用系統
REQUIRE_MFA=false
# 正式環境（HTTPS）設為 true
COOKIE_SECURE=false
# 示範模式：登入頁顯示示範帳號、Worker 持續產生示範預約並推進今日看板、停用替示範帳號啟用兩步驟驗證
# 本機開發與公開示範站設為 true；正式環境（真實診所）務必設為 false
DEMO_MODE=true

# ── Web ──────────────────────────────────────────────
API_URL=http://localhost:4100

# ── 測試 ─────────────────────────────────────────────
# 測試會在這台資料庫伺服器上建立暫時資料庫（名稱 yangbenbu_test_<時間>），測完自動刪除。
# 只用到主機與帳密，資料庫名稱不影響；角色需要 CREATEDB 權限
TEST_DATABASE_URL=postgresql://yangbenbu:yangbenbu@localhost:5432/yangbenbu_test
