{
  "name": "yangbenbu-crm",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "db:migrate": "pnpm --filter @yangbenbu/db migrate:dev",
    "db:deploy": "pnpm --filter @yangbenbu/db migrate:deploy",
    "db:seed": "pnpm --filter @yangbenbu/db seed",
    "db:reset": "pnpm --filter @yangbenbu/db migrate:reset"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.0",
    "turbo": "^2.11.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "prisma", "@swc/core", "esbuild", "@node-rs/argon2"]
  }
}
